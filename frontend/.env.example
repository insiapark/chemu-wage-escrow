# No RPC or wallet is needed for the default browser-local mock demo.
NEXT_PUBLIC_CHAIN_ID=11155111
# Draft EIP-712 domain only; agree with the contract owner before real integration.
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# Real Sepolia mode uses the fixed addresses from src/contracts/sepolia.json.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional public wallet addresses used to initialize a new browser session.
# Existing browser sessions retain their saved participants.
NEXT_PUBLIC_DEMO_EMPLOYER=
NEXT_PUBLIC_DEMO_EMPLOYEE=
# CLI only: set RELAYER_PRIVATE_KEY in the process environment for release:watch --send.
# Never name a private key NEXT_PUBLIC_... and never put it in frontend source.
